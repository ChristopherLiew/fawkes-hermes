# Names of every secret this deployment uses. VALUES NEVER GO IN THIS REPO.
# Set them with `fly secrets set` (docs/DESIGN.md §5); keep originals in a password manager.
#
# fawkes-hermes (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# optional
TELEGRAM_GROUP_ALLOWED_CHATS=
GH_PAT=
# agent tooling: Fly secrets, not /opt/data/.env (the agent owns that file)
MCP_TINYFISH_API_KEY=     # TinyFish search/fetch + cloud browser (browser sessions cost credits)
BRAVE_SEARCH_API_KEY=     # native brave-free backend (search only)
BRAVE_API_KEY=            # same value; read by the brave-search plugin (brave_web_search tool)
API_SERVER_KEY=           # Hermes loopback API server (127.0.0.1:8642, never exposed)
# skills (set with `make skill-secrets`); see skills/README.md
LTA_DATAMALL_KEY=
DATA_GOV_SG_API_KEY=
