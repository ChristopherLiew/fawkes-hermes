# Local dev secrets. Copy this file to .env.local (which is gitignored) and fill it in.
#
# !! Use a SEPARATE dev bot from @BotFather. Never use the production token. !!
# A local gateway on the prod token would conflict with, or take over, the Fly webhook.
# Don't set TELEGRAM_WEBHOOK_URL here: leaving it unset puts Hermes in polling mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# A dedicated OpenRouter key with a small credit limit
OPENROUTER_API_KEY=

# Dashboard basic auth (generate with: openssl rand -base64 24 / openssl rand -hex 32)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
